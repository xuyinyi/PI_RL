{
  "schema_version": 1,
  "gate": "scicf-gate1b1-structure-isolated-two-stage-v1",
  "extension_role": "Gate 1B.3 unseen-structure early-middle dev confirmation only",
  "dataset_roles": {
    "train": "not collected by this extension",
    "dev": "fresh-trajectory and unseen-structure confirmation only",
    "test": "sealed and not collected by this extension"
  },
  "execution": {
    "require_slurm": true,
    "require_clean_git": true,
    "allowed_split": "dev",
    "allowed_stages": ["early", "middle"],
    "llm_calls": 0,
    "ppo_updates": 0
  },
  "structure_exclusion": {
    "manifest_gate": "scicf-gate1b2-nonlinear-validity-development-v1",
    "manifest_sha256": "10b8c9b603bfaec1ff1600c22ca2fb1cb5cb96e5904d95267e42422a8202f8fd",
    "manifest_key": "combined_dev_structure_keys",
    "required": true
  },
  "structure_split": {
    "protocol": "sha256-canonical-component-structure-v1",
    "salt": "scicf-gate1b1-structure-split-20260903-v1",
    "train_upper_exclusive": 60,
    "dev_upper_exclusive": 80,
    "modulus": 100
  },
  "stages": ["early", "middle", "late"],
  "seeds": {
    "train": [4101, 4102, 4103, 4104, 4105, 4106, 4107, 4108],
    "dev": [4241, 4242, 4243, 4244, 4245, 4246, 4247, 4248, 4249, 4250, 4251, 4252, 4253, 4254, 4255, 4256],
    "test": [4301, 4302, 4303, 4304, 4305, 4306, 4307, 4308]
  },
  "checkpoints": {
    "early": "checkpoints/epoch_0/checkpoint_000000/checkpoint-0",
    "middle": "checkpoints/epoch_50/checkpoint_000050/checkpoint-50",
    "late": "checkpoints/epoch_100/checkpoint_000100/checkpoint-100"
  },
  "candidate_pool": {
    "size": 24,
    "budget": 4,
    "cross_timestep": true,
    "require_all_observed_timesteps": true,
    "source_quotas": {
      "policy_near": 8,
      "random_legal": 8,
      "structural": 8
    }
  },
  "verification": {
    "paired_replicates": 2,
    "common_random_numbers": true,
    "confidence_rule": "sign-consistency",
    "sign_consistency_fraction": 1.0,
    "numerical_tolerance": 1e-12,
    "max_steps": 16,
    "atomic_oracle_budget_per_stage_split": 30000
  },
  "features": {
    "protocol": "gate1b1-request-time-trajectory-descriptors-v1",
    "rdkit_descriptors_per_structure": [
      "mol_wt",
      "tpsa",
      "aromatic_ring_count",
      "ring_count",
      "rotatable_bonds",
      "hetero_atom_count",
      "halogen_count",
      "fraction_csp3",
      "h_donors",
      "h_acceptors",
      "attachment_point_count",
      "formal_charge"
    ],
    "validity_filter_uses_policy_score": false,
    "gain_ranker_uses_policy_score": true,
    "forbidden": [
      "candidate_id_as_predictor",
      "counterfactual_terminal_object",
      "counterfactual_properties",
      "verified_gain",
      "verification_acceptance"
    ]
  },
  "models": {
    "validity_filter": {
      "family": "stage-routed frozen models",
      "target": "paired counterfactual terminal-valid fraction",
      "threshold": 0.5,
      "training_stages": ["early", "middle", "late"]
    },
    "policy_conditioned_gain_ranker": {
      "family": "ridge",
      "alpha": 1.0,
      "target": "verified mean reward delta",
      "training_stages": ["middle", "late"],
      "training_rows": "counterfactual terminal-valid fraction equals 1"
    },
    "hyperparameter_search": false
  },
  "selection": {
    "early": "frozen Gate 1B.2 nonlinear validity filter",
    "middle": "frozen Gate 1B.1 linear validity filter then frozen policy-conditioned gain ranker",
    "late": "non-gating saturation diagnostic; abstain while uncalibrated"
  },
  "dev_entry_rule": {
    "minimum_oracle_headroom_fraction_captured": 0.25,
    "required": [
      "fresh dev structures do not overlap train or any prior development structure",
      "early rescue-rate@4 improvement over exact Random is positive and captures at least 25% headroom",
      "middle BestGain@4 improvement over exact Random is positive and captures at least 25% headroom",
      "middle NDCG@4 improvement over exact Random is positive and captures at least 25% headroom",
      "at least 25% of fresh early-middle trajectories contain candidates from more than one timestep"
    ]
  },
  "test_rule": {
    "status": "sealed; no test collection or evaluation in Gate 1B.3-development"
  },
  "authorization": {
    "test_collection_authorized": false,
    "test_evaluation_authorized": false,
    "gate1c_authorized": false,
    "pairwise_refinement_authorized": false,
    "ppo_integration_authorized": false
  }
}
