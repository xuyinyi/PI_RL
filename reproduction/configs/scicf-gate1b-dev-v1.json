{
  "schema_version": 1,
  "gate": "scicf-gate1b-cheap-feature-learnability-v1",
  "dataset_role": "Gate1-dev",
  "execution": {
    "require_slurm": true,
    "require_clean_git": true,
    "new_llm_calls": 0,
    "new_oracle_calls": 0,
    "ppo_updates": 0
  },
  "data": {
    "stages": ["early", "middle", "late"],
    "trajectories_per_stage": 8,
    "candidate_pool_size": 24,
    "acquisition_budget": 4,
    "decision_timestep": 0
  },
  "features": {
    "protocol": "request-time-rdkit-descriptors-v1",
    "allowed_inputs": [
      "pre_state.dianhydride_structure",
      "pre_state.diamine_structure",
      "intervention.component",
      "intervention.metadata.factual_structure",
      "intervention.alternative_structure"
    ],
    "forbidden_inputs": [
      "candidate_id_as_predictor",
      "policy_score",
      "terminal_scientific_object",
      "terminal_properties",
      "verified_gains",
      "verification_outcomes"
    ]
  },
  "model": {
    "family": "ridge",
    "alpha": 1.0,
    "standardization": "training-fold-only",
    "hyperparameter_tuning": false,
    "cross_validation": "leave-one-trajectory-out"
  },
  "targets": {
    "early-invalid": "fraction of paired counterfactual continuations with a valid terminal object",
    "middle-valid": "verified mean reward delta",
    "late-valid": "verified mean reward delta; saturation diagnostic only"
  },
  "inference": {
    "confidence_level": 0.95,
    "bootstrap_resamples": 10000,
    "bootstrap_seed": 51001,
    "permutation_resamples": 10000,
    "permutation_seed": 52001,
    "permutation_scheme": "shuffle targets within trajectory, refit all leave-one-trajectory-out folds",
    "one_sided_alpha": 0.05
  },
  "gate_rule": {
    "minimum_oracle_headroom_fraction_captured": 0.25,
    "early_required_metrics": ["rescue_rate_at_4"],
    "middle_required_metrics": ["best_gain_at_4", "ndcg_at_4"],
    "per_metric_requirements": [
      "descriptor minus exact expected Random mean is positive",
      "trajectory-bootstrap 95% confidence interval lower bound is positive",
      "one-sided within-trajectory permutation p-value is at most 0.05",
      "mean descriptor improvement captures at least 25% of mean Oracle-minus-Random headroom"
    ],
    "late_contributes_to_gate": false,
    "gate1b_pass_requires": "early-invalid and both middle-valid metrics pass"
  },
  "authorization": {
    "llm_gate1c_authorized": false,
    "pairwise_refinement_authorized": false,
    "ppo_integration_authorized": false
  }
}
