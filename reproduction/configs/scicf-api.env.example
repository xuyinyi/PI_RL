# Copy this file on n001 to a path outside Git, then chmod 600 that copy.
# Do not commit the populated file and do not paste the API key into Slurm args.
SCICF_LLM_API_URL=https://your-api.example/v1/chat/completions
SCICF_LLM_API_KEY=replace-with-private-key
SCICF_LLM_MODEL_ID=your-model-id
SCICF_LLM_MODEL_REVISION=immutable-model-or-deployment-revision
SCICF_LLM_PROVIDER_ID=your-private-provider

# Optional compatibility settings:
SCICF_LLM_API_KEY_HEADER=Authorization
SCICF_LLM_API_KEY_PREFIX=Bearer
SCICF_LLM_ALLOW_INSECURE_HTTP=false
SCICF_LLM_INCLUDE_SEED=true
SCICF_LLM_JSON_MODE=false
SCICF_LLM_MAX_TOKENS_FIELD=max_tokens
